# Copy to .env.local for local work, or paste these into the Render or Vercel
# dashboard for a deploy. Nothing here is secret until you fill it in. Once you
# do, never commit the filled file. .env and .env.local are gitignored.
#
# The demo runs with every single one of these blank. Postgres falls back to
# PGlite, Jobber falls back to the mock customer book, and Twilio falls back to
# preview messages rendered on screen. Fill them in as each service is ready.

# Postgres connection string. OPTIONAL. Leave it unset and the demo runs on
# PGlite, an embedded Postgres that needs no account, no Docker and no network.
# Set it only when the dispatch board has to survive a restart, for example a
# Neon, Supabase or Render Postgres string. Same SQL either way.
DATABASE_URL=

# Where PGlite keeps its files when DATABASE_URL is unset. Defaults to ./.pgdata.
# On Render use /tmp/pgdata, because the rest of the filesystem is read only on
# some instance types.
PGLITE_DIR=./.pgdata

# SECRET. Retell dashboard, API Keys. It has two jobs: push-demo-config.ts
# authenticates with it, and both webhook routes verify the x-retell-signature
# HMAC with it. The key here must be the same key that created the agent, or
# every webhook is rejected as an invalid signature.
RETELL_API_KEY=

# Public key for the browser call widget. Retell dashboard, same page as the
# API key. Safe to ship to the browser. Needed only for in browser calls.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=

# The agent id. Printed by: npx tsx retell/push-demo-config.ts
NEXT_PUBLIC_RETELL_AGENT_ID=

# The phone number bound to the agent, in E.164, for example +18885551234.
# Shown on the demo page so the owner can dial it from their own mobile.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# Accept unsigned webhooks. Keep it false or unset for a real demo, so the
# signature check runs and the pipeline panel shows it passing. Set it to true
# only to drive tests/demo-pipeline.http by hand without a voice call, and set
# it back afterwards.
ALLOW_UNSIGNED_WEBHOOKS=false

# Where the on call technician page is sent. Use your own mobile in E.164 so
# you can hold the phone up in the room when the emergency scene fires. Falls
# back to a dummy number when unset, and the page still renders on screen.
DEMO_TECHNICIAN_NUMBER=

# SECRET. Jobber OAuth client id, from the app you create in the Jobber
# Developer Center. Leave blank to stay on the mock customer book.
JOBBER_CLIENT_ID=

# SECRET. Jobber OAuth client secret, from the same app screen.
JOBBER_CLIENT_SECRET=

# SECRET. Jobber OAuth refresh token for the test account. Jobber rotates it on
# every token exchange, so the value you paste here goes stale as soon as the
# app refreshes once. See JOBBER_REFRESH_TOKEN_SINK below.
JOBBER_REFRESH_TOKEN=

# mock, live, or blank. Blank means auto: live when all three Jobber secrets
# are present, mock otherwise. Set it to mock to force the mock back on for a
# safe rehearsal even with real credentials in place.
JOBBER_MODE=mock

# The X-JOBBER-GRAPHQL-VERSION header, pinned to an explicit date rather than
# left to default. Defaults to 2026-05-12 when unset.
JOBBER_API_VERSION=2026-05-12

# A writable file path where the rotated refresh token is written after every
# exchange, so the next start does not fail with an invalid grant. On Render
# use /tmp/jobber-refresh-token and accept that a restart loses it. Leave it
# blank locally and copy the new token by hand from the logs.
JOBBER_REFRESH_TOKEN_SINK=

# SECRET. Twilio account SID, starts with AC. All three Twilio values must be
# present or the SMS layer stays in preview mode.
TWILIO_ACCOUNT_SID=

# SECRET. Twilio auth token, from the same console page as the SID.
TWILIO_AUTH_TOKEN=

# The Twilio number messages are sent from, in E.164. Use the toll free number,
# and only after toll free verification has cleared, or Twilio rejects the send.
TWILIO_FROM_NUMBER=
